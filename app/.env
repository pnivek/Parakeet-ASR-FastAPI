# --- NeMo ASR Model Configuration ---
BATCH_SIZE=4                      # (int) ASR batch size during chunked inference, bigger is faster but uses more memory.
NUM_WORKERS=0                     # (int) number of workers for DataLoader
TRANSCRIBE_CHUNK_LEN=30           # (seconds) audio chunking: how long each chunk is.
TRANSCRIBE_OVERLAP=5              # (seconds) chunk overlap: how much overlap between chunks. increase for better context/quality at the cost of processing times
LONG_AUDIO_THRESHOLD=480          # (seconds) length threshold before using long audio strategy

# --- Strategy Configuration ---
DEFAULT_STRATEGY=auto             # auto | full | chunked | progressive. "auto" picks based on duration / streaming state.
MAX_FULL_WAVEFORM_S=1440          # (seconds) cap for auto-selecting "full" mode. 24 min = NVIDIA full-attention ceiling.
EARLY_BUFFER_TARGET_S=15          # (seconds) PCM buffered before progressive mode emits first partial.

# Phase 6 — Stateful chunked engine (BatchedFrameASRTDT).
# true  = chunked path uses NeMo's stateful TDT engine, decoder state carries
#         across chunks. Single concatenated text segment (no per-utterance
#         timestamps yet). Best chunked-mode quality.
# false = legacy independent-overlapping-chunk path with dedup. Keeps per-chunk
#         timestamps.
USE_STATEFUL_CHUNKED=true

# --- Stateful Streaming (Phase 6, BatchedFrameASRTDT) ---
# NVIDIA-recommended: 10-10-5 for offline-like quality; 10-2-2 for ~4s live latency.
STREAMING_LEFT_CONTEXT_S=10
STREAMING_CHUNK_S=10
STREAMING_RIGHT_CONTEXT_S=5
STREAMING_LIVE_CHUNK_S=2          # chunk size when live_latency=true on a progressive request.
STREAMING_LIVE_RIGHT_CONTEXT_S=2

# --- Endpoint Configuration ---
PORT=8777                         # Port for the REST endpoint.

# --- Logging Configuration ---
LOG_LEVEL=INFO                    # Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
