# --- NeMo ASR Model Configuration ---
BATCH_SIZE=4                      # (int) ASR batch size, bigger is faster but uses more memory.
NUM_WORKERS=0                     # (int) DataLoader workers.
TRANSCRIBE_CHUNK_LEN=30           # (seconds) historical knob — unused now that legacy chunked is retired; kept for client compat.
TRANSCRIBE_OVERLAP=5              # (seconds) historical knob — same as above.
LONG_AUDIO_THRESHOLD=480          # (seconds) duration above which the encoder switches to local-window attention.

# --- Strategy Configuration ---
DEFAULT_STRATEGY=auto             # auto | full | chunked | progressive (chunked_v2 / progressive_v2 still accepted as aliases).
                                  # "auto" routes to chunked for REST and progressive for WS.
MAX_FULL_WAVEFORM_S=1440          # (seconds) cap for explicit "full" requests. 24 min = NVIDIA full-attention ceiling.
EARLY_BUFFER_TARGET_S=15          # (seconds) PCM buffered before progressive mode emits first partial.

# NeMo's CUDA-graph RNNT/TDT decoder (FULL_GRAPH mode). Default ON: a 2026-05
# investigation traced spurious crashes to `empty_cache()` between transcribes
# invalidating addresses baked into the captured graph (NeMo issue #14727).
# Those calls are now skipped when graphs are on. Measured ~30% speedup on
# FULL transcribes (p99 0.16 s vs ~0.22 s eager). Flip to false only if you
# suspect a new graph-related regression.
USE_CUDA_GRAPHS=true

# --- Streaming window presets ---
# 10-10-5 for offline-like quality (default); 10-2-2 for ~6 s live emission lag.
STREAMING_LEFT_CONTEXT_S=10
STREAMING_CHUNK_S=10
STREAMING_RIGHT_CONTEXT_S=5
STREAMING_LIVE_CHUNK_S=2
STREAMING_LIVE_RIGHT_CONTEXT_S=2

# --- Endpoint Configuration ---
PORT=8777

# --- Logging Configuration ---
LOG_LEVEL=INFO
